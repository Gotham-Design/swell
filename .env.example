# Local values come from `npm run db:status`. Production: the hosted project's values.

# Public: inlined into the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:58321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: never prefix with NEXT_PUBLIC_, never import outside src/lib/env/server.ts.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Category suggestions model: claude-haiku-5-5 (default) or claude-sonnet-5-5.
ANTHROPIC_MODEL=claude-haiku-5-5

# Category suggestions provider: Jev (TypeSafe) when TYPESAFE_API_KEY is set, else Anthropic.
# Force one with AI_PROVIDER=jev|anthropic. Pin a Jev version with JEV_MODEL (default jev-latest).
TYPESAFE_API_KEY=
JEV_MODEL=
AI_PROVIDER=

# App emails (recurring statement requests) through Resend. Unset: schedules are saved but nothing is sent.
RESEND_API_KEY=
# A sender on a Resend-verified domain, e.g. Swell <statements@mail.example.com>
EMAIL_FROM=
# Vercel Cron sends it as a Bearer token to /api/cron/statement-requests.
CRON_SECRET=
# Optional: the site address used in emailed links (defaults to the cron request's origin).
APP_ORIGIN=
